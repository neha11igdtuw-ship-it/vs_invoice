# MongoDB connection string (MongoDB Atlas recommended; Prisma needs a replica set, which Atlas provides).
DATABASE_URL="mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/vs_invoice?retryWrites=true&w=majority"

# Long random string, at least 32 chars. Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# First login. Only used when no user exists yet.
ADMIN_USERNAME=
ADMIN_PASSWORD=

# Optional
PORT=3001
SESSION_HOURS=12
# Only needed if the frontend is hosted on a different origin than the API.
CORS_ORIGIN=
