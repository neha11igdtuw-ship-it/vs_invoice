generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

model FinancialYear {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  name      String   @unique
  startDate DateTime
  endDate   DateTime
  isActive  Boolean  @default(false)
  createdAt DateTime @default(now())

  invoices         Invoice[]
  redBookEntries   RedBookEntry[]
  ledgerEntries    LedgerEntry[]
  dayBookEntries   DayBookEntry[]
  arrivals         Arrival[]
  teeps            TEEP[]
}

model Invoice {
  id                String   @id @default(auto()) @map("_id") @db.ObjectId
  financialYearId   String @db.ObjectId
  serialNumber      Int
  invoiceNumber     String
  invoiceDate       DateTime
  customerName      String
  customerPhone     String?
  customerAddress   String?
  truckNumber       String?
  challanNumber     String?
  nag               String?
  nagSummary        String?
  discount          String  @default("0")
  tax               String  @default("0")
  additionalCharges String  @default("0")
  grossTotal        String  @default("0")
  totalExpenses     String  @default("0")
  grandTotal        String  @default("0")
  status            String   @default("active")
  expensesJson      String?
  labourAuto        Boolean  @default(false)
  labourPerNag      String?
  forwardingAuto    Boolean  @default(false)
  forwardingPercent String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  financialYear FinancialYear @relation(fields: [financialYearId], references: [id])
  items         InvoiceItem[]

  @@unique([financialYearId, serialNumber])
  @@index([financialYearId])
  @@index([invoiceDate])
  @@index([customerName])
  @@index([status])
}

model InvoiceItem {
  id          String  @id @default(auto()) @map("_id") @db.ObjectId
  invoiceId   String @db.ObjectId
  description String
  quantity    String
  rate        String
  amount      String
  sortOrder   Int     @default(0)

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId])
}

model RedBookEntry {
  id              String   @id @default(auto()) @map("_id") @db.ObjectId
  financialYearId String @db.ObjectId
  entryDate       DateTime
  recordNumber    String
  partyName       String
  description     String?
  quantity        String  @default("0")
  rate            String  @default("0")
  amount          String  @default("0")
  remarks         String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  financialYear FinancialYear @relation(fields: [financialYearId], references: [id])

  @@index([financialYearId])
  @@index([entryDate])
  @@index([partyName])
}

model LedgerEntry {
  id              String   @id @default(auto()) @map("_id") @db.ObjectId
  financialYearId String @db.ObjectId
  partyName       String
  entryDate       DateTime
  description     String?
  debit           String  @default("0")
  credit          String  @default("0")
  runningBalance  String  @default("0")
  paymentStatus   String   @default("pending")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  financialYear FinancialYear @relation(fields: [financialYearId], references: [id])

  @@index([financialYearId])
  @@index([partyName])
  @@index([entryDate])
}

model DayBookEntry {
  id              String   @id @default(auto()) @map("_id") @db.ObjectId
  financialYearId String @db.ObjectId
  entryDate       DateTime
  voucherNumber   String
  transactionType String
  partyName       String
  description     String?
  debit           String  @default("0")
  credit          String  @default("0")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  financialYear FinancialYear @relation(fields: [financialYearId], references: [id])

  @@index([financialYearId])
  @@index([entryDate])
  @@index([voucherNumber])
}

model Arrival {
  id              String   @id @default(auto()) @map("_id") @db.ObjectId
  financialYearId String @db.ObjectId
  arrivalNumber   String
  arrivalDate     DateTime
  partyName       String
  itemName        String
  quantity        String  @default("0")
  rate            String  @default("0")
  amount          String  @default("0")
  remarks         String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  financialYear FinancialYear @relation(fields: [financialYearId], references: [id])

  @@index([financialYearId])
  @@index([arrivalDate])
  @@index([partyName])
}

model TEEP {
  id              String   @id @default(auto()) @map("_id") @db.ObjectId
  financialYearId String @db.ObjectId
  teepNumber      String
  saleDate        DateTime
  remarks         String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  financialYear FinancialYear @relation(fields: [financialYearId], references: [id])
  customers     TEEPCustomer[]

  @@index([financialYearId])
  @@index([saleDate])
}

model TEEPCustomer {
  id               String   @id @default(auto()) @map("_id") @db.ObjectId
  teepId           String @db.ObjectId
  billNumber       String
  customerName     String
  discountType     String   @default("fixed")
  discountValue    String  @default("0")
  discountAmount   String  @default("0")
  subtotal         String  @default("0")
  netPayable       String  @default("0")
  amountPaid       String  @default("0")
  remainingBalance String  @default("0")
  paymentDuration  String   @default("immediate")
  customDurationDays Int?
  paymentDueDate   DateTime
  paymentStatus    String   @default("unpaid")
  remarks          String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  teep              TEEP                   @relation(fields: [teepId], references: [id], onDelete: Cascade)
  items             TEEPItem[]
  additionalCharges TEEPAdditionalCharge[]
  payments          TEEPPayment[]

  @@index([teepId])
  @@index([customerName])
  @@index([paymentStatus])
}

model TEEPItem {
  id         String  @id @default(auto()) @map("_id") @db.ObjectId
  customerId String @db.ObjectId
  goodsName  String
  quantity   String @default("0")
  unit       String  @default("Nag")
  rate       String @default("0")
  amount     String @default("0")
  sortOrder  Int     @default(0)

  customer TEEPCustomer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId])
}

model TEEPAdditionalCharge {
  id         String  @id @default(auto()) @map("_id") @db.ObjectId
  customerId String @db.ObjectId
  name       String
  chargeType String  @default("fixed")
  value      String @default("0")
  amount     String @default("0")

  customer TEEPCustomer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId])
}

model TEEPPayment {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  customerId  String @db.ObjectId
  amount      String  @default("0")
  paymentDate DateTime
  remarks     String?
  createdAt   DateTime @default(now())

  customer TEEPCustomer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId])
}

model User {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  username     String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}
